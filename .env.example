# Mini Simon - PythonAnywhere Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to GitHub - it contains sensitive credentials

# =============================================================================
# FYERS API CREDENTIALS (Required)
# =============================================================================
FYERS_APP_ID=YOUR_APP_ID_HERE
FYERS_ACCESS_TOKEN=YOUR_ACCESS_TOKEN_HERE
FYERS_CLIENT_ID=YOUR_CLIENT_ID_HERE
FYERS_SECRET_KEY=YOUR_SECRET_KEY_HERE

# =============================================================================
# DISCORD WEBHOOK (Optional - for notifications)
# =============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL

# =============================================================================
# PYTHONANYWHERE CONFIGURATION
# =============================================================================
# Your PythonAnywhere username
PYTHONANYWHERE_USERNAME=your_username

# Path to your project on PythonAnywhere (adjust if different)
PYTHONANYWHERE_PROJECT_PATH=/home/your_username/mini-simon

# Set to 'true' when running on PythonAnywhere
PYTHONANYWHERE_DOMAIN=pythonanywhere.com

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable cloud deployment logging (separate from engine logs)
CLOUD_DEPLOY_LOG=true

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================
# Enable/disable paper trading mode
PAPER_TRADING_MODE=true

# Risk per trade (percentage of account)
RISK_PER_TRADE=1.0

# Account size for position sizing
ACCOUNT_SIZE=100000

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
# WebSocket reconnection attempts
WS_MAX_RECONNECT_ATTEMPTS=10

# Delay between reconnection attempts (seconds)
WS_RECONNECT_DELAY=5

# Heartbeat interval to keep connection alive (seconds)
WS_HEARTBEAT_INTERVAL=30

# Tick timeout - reconnect if no tick received for this many seconds
WS_TICK_TIMEOUT=90

# =============================================================================
# MARKET DATA CONFIGURATION
# =============================================================================
# Enable MCX (commodity) market data
ENABLE_MCX=true

# Default timeframes to track
DEFAULT_TIMEFRAMES=5m,15m,60m

# Maximum candles to store per symbol/timeframe
MAX_CANDLES=500
