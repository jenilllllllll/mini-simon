# Mini-Simon Production Environment Configuration
# Copy this file to /opt/mini-simon/.env and fill in your values
# IMPORTANT: Never commit the actual .env file with real credentials to git!

# =============================================================================
# FYERS API CREDENTIALS (Required)
# =============================================================================
FYERS_APP_ID=your_app_id_here
FYERS_ACCESS_TOKEN=your_access_token_here

# Optional: For auto-refresh functionality
FYERS_REFRESH_TOKEN=your_refresh_token_here

# =============================================================================
# SERVER CONFIGURATION (Optional)
# =============================================================================
# Host and port for the FastAPI server (behind Nginx)
MINI_SIMON_HOST=127.0.0.1
MINI_SIMON_PORT=8000

# Number of workers (leave at 1 when using PM2)
MINI_SIMON_WORKERS=1

# =============================================================================
# NOTIFICATIONS (Optional)
# =============================================================================
# Discord webhook for trade alerts and system notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# =============================================================================
# TRADING CONFIGURATION (Optional)
# =============================================================================
# Enable/disable paper trading mode
PAPER_TRADING=true

# Risk management settings
MAX_POSITION_SIZE=100000
MAX_DAILY_LOSS=-5000

# =============================================================================
# LOGGING (Optional)
# =============================================================================
LOG_LEVEL=INFO
LOG_TO_FILE=true

# =============================================================================
# DATABASE (Optional)
# =============================================================================
DATABASE_URL=sqlite:///opt/mini-simon/trades/trades.db

# =============================================================================
# TIMEZONE (Set by launch.sh, but can override here)
# =============================================================================
TZ=Asia/Kolkata
